// BUILDTRACE - Prisma Schema
// Aligné avec le Cahier d'Architecture MVP (octobre 2026)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  USER
  PRO
  BUSINESS
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DELETED
}

enum OrganizationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  TRIALING
}

enum MaterialStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  RESERVED
  ARCHIVED
  REJECTED
}

enum MaterialCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
}

enum AiAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  VALIDATED
  REJECTED
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum MediaType {
  IMAGE
  DOCUMENT
  PDF
  VIDEO
}

// ==================== MODELS ====================

model User {
  id            String     @id @default(cuid())
  email         String?    @unique
  phone         String?    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  avatarUrl     String?
  locale        String     @default("fr")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastLoginAt   DateTime?

  organizationMembers OrganizationMember[]
  ownedOrganizations  Organization[]       @relation("OrganizationOwner")
  materials           Material[]           @relation("MaterialOwner")
  buildings           Building[]
  messagesSent        Message[]            @relation("MessageSender")
  messagesReceived    Message[]            @relation("MessageReceiver")
  reports             Report[]             @relation("ReportAuthor")
  subscriptions       Subscription[]
  auditLogs           AuditLog[]
  events              Event[]
  refreshTokens       RefreshToken[]

  @@index([email])
  @@index([phone])
  @@index([status])
  @@map("users")
}

model Organization {
  id          String             @id @default(cuid())
  name        String
  country     String             @default("TG")
  city        String?
  address     String?
  status      OrganizationStatus @default(PENDING)
  verifiedAt  DateTime?
  ownerId     String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  owner       User               @relation("OrganizationOwner", fields: [ownerId], references: [id])
  members     OrganizationMember[]
  materials   Material[]
  buildings   Building[]

  @@index([status])
  @@index([ownerId])
  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("member")
  joinedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String
  plan              SubscriptionPlan   @default(FREE)
  status            SubscriptionStatus @default(ACTIVE)
  price             Decimal?           @db.Decimal(10, 2)
  currency          String             @default("XOF")
  startsAt          DateTime           @default(now())
  endsAt            DateTime?
  canceledAt        DateTime?
  paymentProvider   String?
  providerRef       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([plan])
  @@map("subscriptions")
}

model Building {
  id             String   @id @default(cuid())
  name           String
  address        String?
  city           String?
  country        String   @default("TG")
  latitude       Float?
  longitude      Float?
  buildingType   String?
  yearBuilt      Int?
  description    String?
  ownerId        String
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner        User          @relation(fields: [ownerId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  materials    Material[]
  media        Media[]

  @@index([ownerId])
  @@index([city])
  @@map("buildings")
}

model Material {
  id              String            @id @default(cuid())
  title           String
  description     String?
  category        String
  materialType    String?
  dimensions      String?
  quantity        Float             @default(1)
  unit            String            @default("unité")
  condition       MaterialCondition @default(GOOD)
  status          MaterialStatus    @default(DRAFT)
  indicativePrice Decimal?          @db.Decimal(12, 2)
  currency        String            @default("XOF")
  latitude        Float?
  longitude       Float?
  city            String?
  country         String            @default("TG")
  ownerId         String
  organizationId  String?
  buildingId      String?
  publishedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  owner        User              @relation("MaterialOwner", fields: [ownerId], references: [id])
  organization Organization?     @relation(fields: [organizationId], references: [id])
  building     Building?         @relation(fields: [buildingId], references: [id])
  passport     MaterialPassport?
  media        Media[]
  aiAnalyses   AiAnalysis[]
  messages     Message[]

  @@index([status])
  @@index([category])
  @@index([ownerId])
  @@index([city])
  @@index([latitude, longitude])
  @@map("materials")
}

model MaterialPassport {
  id            String    @id @default(cuid())
  materialId    String    @unique
  passportCode  String    @unique
  origin        String?
  history       Json?
  technicalData Json?
  documents     Json?
  qrCodeUrl     String?
  isPublic      Boolean   @default(false)
  validatedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([passportCode])
  @@map("material_passports")
}

model Media {
  id         String    @id @default(cuid())
  url        String
  key        String?
  type       MediaType @default(IMAGE)
  mimeType   String?
  size       Int?
  width      Int?
  height     Int?
  alt        String?
  materialId String?
  buildingId String?
  uploadedBy String?
  createdAt  DateTime  @default(now())

  material Material? @relation(fields: [materialId], references: [id], onDelete: Cascade)
  building Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([buildingId])
  @@map("media")
}

model AiAnalysis {
  id           String           @id @default(cuid())
  materialId   String?
  mediaId      String?
  status       AiAnalysisStatus @default(PENDING)
  model        String?
  modelVersion String?
  inputType    String?
  result       Json?
  confidence   Float?
  alerts       Json?
  validatedBy  String?
  validatedAt  DateTime?
  errorMessage String?
  costEstimate Float?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  material Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([materialId])
  @@index([status])
  @@map("ai_analyses")
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  materialId String?
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User      @relation("MessageSender", fields: [senderId], references: [id])
  receiver User      @relation("MessageReceiver", fields: [receiverId], references: [id])
  material Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([senderId])
  @@index([receiverId])
  @@index([materialId])
  @@map("messages")
}

model Report {
  id          String       @id @default(cuid())
  authorId    String
  targetType  String
  targetId    String
  reason      String
  description String?
  status      ReportStatus @default(OPEN)
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  author User @relation("ReportAuthor", fields: [authorId], references: [id])

  @@index([status])
  @@index([targetType, targetId])
  @@map("reports")
}

model Event {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  payload   Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("events")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}
